@inproceedings{Feng2025,
  author = {Feng, Dong and Chang, Xiaorong and Zhang, Xu},
  title = {Research on dynamic key generation and data encryption scheme based on chaotic mapping and SM4},
  year = {2025},
  isbn = {9798400709999},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3708036.3708245},
  doi = {10.1145/3708036.3708245},
  abstract = {In the field of information security, the storage of private data is always one of the key security risk points. This study aims to design and implement a dynamic key generation and data encryption scheme based on chaotic mapping and SM4 algorithm. By selecting Logistic chaotic mapping to generate pseudo-random sequences, the unpredictability of chaotic systems is used for the dynamic update of SM4 keys, thereby enhancing the security and randomness of SM4 key updates. Then, combining the encryption security of SM4 algorithm and the encryption speed advantage of chaotic sequence, data storage encryption is achieved through chaotic sequence mapping parameter initialization, chaotic sequence binary quantization, SM4 dynamic encryption and tail processing. Experimental analysis shows that the algorithm has the characteristics of large key space and good key sensitivity. While improving the encryption speed, it effectively reduces the memory usage and maintains high execution efficiency.},
  booktitle = {Proceedings of the 2024 5th International Conference on Computer Science and Management Technology},
  pages = {1258-1265},
  numpages = {8},
  keywords = {Block encryption algorithm, Chaotic sequence, Chaotic system, Data encryption, SM4 algorithm},
}

